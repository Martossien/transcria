[Unit]
Description=TranscrIA — Portail de transcription de réunion
After=network-online.target postgresql.service
Wants=network-online.target
# Si la base PostgreSQL est sur cette machine, décommentez pour garantir l'ordre
# de démarrage (sans échouer si Postgres est distant) :
# Wants=postgresql.service

[Service]
Type=forking
PIDFile=/run/transcrIA.pid
User=root
Environment=PORT=7870
Environment=HOST=0.0.0.0
Environment=DEBUG=false
Environment=LOG_FILE=/var/log/transcrIA.log
Environment=PID_FILE=/run/transcrIA.pid
Environment=VENV=/home/admin_ia/transcria/venv
# ── Sécurité S1.6 : racines d'où un script déclaré en configuration peut être EXÉCUTÉ ──
# `<dépôt>/scripts` est toujours autorisée. Cette variable l'ÉTEND, pour les exploitants
# qui rangent leurs lanceurs ailleurs (séparateur « : », comme un PATH).
#
# Elle vit ICI et non dans config.yaml — c'est délibéré : l'administrateur applicatif édite
# la configuration depuis /admin/config, il réglerait donc lui-même les limites censées le
# contraindre. Une unité systemd est hors de sa portée.
# Environment=TRANSCRIA_SCRIPT_ROOTS=/opt/transcria-lanceurs
Environment=HF_HOME=/home/admin_ia/.cache/huggingface
ExecStart=/home/admin_ia/transcria/start.sh
ExecStop=/home/admin_ia/transcria/stop.sh
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
TimeoutStartSec=60
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target