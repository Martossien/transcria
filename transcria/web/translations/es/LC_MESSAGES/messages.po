msgstr "Debe coincidir con el alias servido (véase scripts/check_arbitrage_llm.sh)."

#: transcria/web/config_form.py:97
msgid "File & exécution"
msgstr "Cola y ejecución"

#: transcria/web/config_form.py:98
msgid "File GPU persistante et parallélisme des jobs."
msgstr "Cola GPU persistente y paralelismo de los trabajos."

#: transcria/web/config_form.py:100
msgid "File persistante activée"
msgstr "Cola persistente activada"

#: transcria/web/config_form.py:101
msgid "Mise en file des traitements (recommandé)."
msgstr "Puesta en cola de los trabajos (recomendada)."

#: transcria/web/config_form.py:102 transcria/web/templates/schedule.html:160
msgid "Jobs simultanés max"
msgstr "Trabajos simultáneos máx."

#: transcria/web/config_form.py:103
msgid "Concurrence par défaut (1 = comportement historique)."
msgstr "Concurrencia predeterminada (1 = comportamiento histórico)."

#: transcria/web/config_form.py:104
#: transcria/web/templates/dashboard_status.html:84
msgid "Stockage des fichiers de jobs"
msgstr "Almacenamiento de los archivos de los trabajos"

#: transcria/web/config_form.py:106
msgid "fs (défaut) : disque local — suffisant en tout-en-un ou avec un jobs_dir partagé (NFS). pg : fichiers répliqués via PostgreSQL — REQUIS quand la frontale (role=web) et le worker (role=scheduler) sont sur deux machines sans filesystem commun (cf. docs/STOCKAGE_PARTAGE_JOBS.md)."
msgstr "fs (predeterminado): disco local — suficiente en modo todo en uno o con un jobs_dir compartido (NFS). pg: archivos replicados mediante PostgreSQL — OBLIGATORIO cuando el frontend (role=web) y el worker (role=scheduler) están en dos máquinas sin sistema de archivos compartido (véase docs/STOCKAGE_PARTAGE_JOBS.md)."

#: transcria/web/config_form.py:113
msgid "Ressources GPU"
msgstr "Recursos GPU"

#: transcria/web/config_form.py:114
msgid "Récupération de la VRAM quand un job est bloqué faute de mémoire GPU."
msgstr "Recuperación de la VRAM cuando un trabajo está bloqueado por falta de memoria GPU."

#: transcria/web/config_form.py:116
msgid "Politique de préemption VRAM"
msgstr "Política de preempción de VRAM"

#: transcria/web/config_form.py:118
msgid "own-only (recommandé) : n'arrête que NOS process gérés inactifs (LLM d'arbitrage), jamais un process tiers. aggressive : préempte aussi les serveurs d'inférence tiers, uniquement dans la fenêtre calendaire « force_gpu » — à réserver à un GPU dédié à TranscrIA."
msgstr "own-only (recomendado): solo detiene NUESTROS procesos gestionados inactivos (LLM de arbitraje), nunca un proceso de terceros. aggressive: también detiene temporalmente los servidores de inferencia de terceros, únicamente dentro de la franja horaria «force_gpu» — reservar para una GPU dedicada a TranscrIA."

#: transcria/web/config_form.py:122
msgid "VRAM libre minimale (Mo)"
msgstr "VRAM libre mínima (MB)"

#: transcria/web/config_form.py:123
msgid "Marge libre exigée en plus du besoin d'une phase avant de l'allouer."
msgstr "Margen libre exigido, además de la necesidad de una fase, antes de asignarla."

#: transcria/web/config_form.py:127
msgid "Sécurité & upload"
msgstr "Seguridad y carga de archivos"

#: transcria/web/config_form.py:128
msgid "Limites d'upload et suppression des jobs."
msgstr "Límites de carga y eliminación de trabajos."

#: transcria/web/config_form.py:130
msgid "Taille max d'upload (Mo)"
msgstr "Tamaño máx. de carga (MB)"

#: transcria/web/config_form.py:131
msgid "Taille maximale d'un fichier déposé."
msgstr "Tamaño máximo de un archivo cargado."

#: transcria/web/config_form.py:132
msgid "Extensions autorisées"
msgstr "Extensiones permitidas"

#: transcria/web/config_form.py:133
msgid "Liste séparée par des virgules, ex. mp3, wav, mp4, m4a."
msgstr "Lista separada por comas, ej. mp3, wav, mp4, m4a."

#: transcria/web/config_form.py:134
msgid "Autoriser la suppression de jobs"
msgstr "Permitir la eliminación de trabajos"

#: transcria/web/config_form.py:135
msgid "Permet aux admins de supprimer un job et ses fichiers."
msgstr "Permite a los administradores eliminar un trabajo y sus archivos."

#: transcria/web/config_form.py:139
msgid "Durcissement HTTP(S)"
msgstr "Endurecimiento de HTTP(S)"

#: transcria/web/config_form.py:140
msgid "Sécurité du transport. Tout est opt-in (défaut = HTTP, dev/tout-en-un). Le proxy TLS et le cookie sécurisé exigent un redémarrage du service."
msgstr "Seguridad del transporte. Todo es opcional (predeterminado = HTTP, desarrollo/todo en uno). El proxy TLS y la cookie segura requieren un reinicio del servicio."

#: transcria/web/config_form.py:143
msgid "Derrière un proxy TLS (HTTPS)"
msgstr "Detrás de un proxy TLS (HTTPS)"

#: transcria/web/config_form.py:144
msgid "À activer si un reverse-proxy (nginx, Caddy…) termine le HTTPS devant TranscrIA : l'app reconnaît alors HTTPS (via X-Forwarded-Proto), marque le cookie de session Secure et peut émettre le HSTS. L'adresse cliente n'est JAMAIS lue depuis X-Forwarded-For (anti-usurpation). Redémarrage requis."
msgstr "Actívelo si un proxy inverso (nginx, Caddy…) termina el HTTPS delante de TranscrIA: la aplicación reconoce entonces HTTPS (mediante X-Forwarded-Proto), marca la cookie de sesión como Secure y puede emitir HSTS. La dirección del cliente NUNCA se lee desde X-Forwarded-For (antisuplantación). Requiere reinicio."

#: transcria/web/config_form.py:148
msgid "Cookie de session « Secure »"
msgstr "Cookie de sesión «Secure»"

#: transcria/web/config_form.py:149
msgid "Marque le cookie de session Secure (envoyé seulement en HTTPS). Implicite si « Derrière un proxy TLS » est activé. Redémarrage requis."
msgstr "Marca la cookie de sesión como Secure (enviada solo por HTTPS). Implícito si «Detrás de un proxy TLS» está activado. Requiere reinicio."

#: transcria/web/config_form.py:151
msgid "HSTS (forcer HTTPS côté navigateur)"
msgstr "HSTS (forzar HTTPS en el navegador)"

#: transcria/web/config_form.py:152
msgid "Émet l'en-tête Strict-Transport-Security, uniquement sur une réponse servie en HTTPS réel (nécessite « Derrière un proxy TLS »). Anti-rétrogradation HTTP."
msgstr "Emite la cabecera Strict-Transport-Security, únicamente en una respuesta servida por HTTPS real (requiere «Detrás de un proxy TLS»). Antidegradación a HTTP."

#: transcria/web/config_form.py:154
msgid "Contrôle d'origine (anti-CSRF renforcé)"
msgstr "Control de origen (anti-CSRF reforzado)"

#: transcria/web/config_form.py:156
msgid "Refuse un envoi de formulaire provenant d'un autre site (en-tête Origin croisé), en complément de SameSite. N'affecte ni l'API par jeton, ni les requêtes sans en-tête Origin."
msgstr "Rechaza el envío de un formulario procedente de otro sitio (cabecera Origin cruzada), como complemento de SameSite. No afecta ni a la API por token ni a las solicitudes sin cabecera Origin."

#: transcria/web/config_form.py:159
msgid "Jetons CSRF (protection forte)"
msgstr "Tokens CSRF (protección fuerte)"

#: transcria/web/config_form.py:160
msgid "Exige un jeton anti-CSRF à chaque requête mutante authentifiée par cookie (injecté automatiquement dans les formulaires et les appels de l'interface). Défense la plus forte ; l'API par jeton Bearer (scripts) reste exemptée."
msgstr "Exige un token anti-CSRF en cada solicitud que modifica datos y está autenticada por cookie (se inyecta automáticamente en los formularios y en las llamadas de la interfaz). Es la defensa más fuerte; la API por token Bearer (scripts) queda exenta."

#: transcria/web/config_form.py:163
msgid "Content-Security-Policy (CSP)"
msgstr "Content-Security-Policy (CSP)"

#: transcria/web/config_form.py:165
msgid "Politique de sécurité du contenu. off : désactivée. report-only : le navigateur SIGNALE les violations sans rien bloquer (à déployer d'abord, pour observer). enforce : appliquée. Verrouille cadres, objets, base, formulaires et origines des ressources."
msgstr "Política de seguridad del contenido. off: desactivada. report-only: el navegador NOTIFICA las infracciones sin bloquear nada (se recomienda desplegarla primero, para observar). enforce: aplicada. Restringe marcos, objetos, base, formularios y orígenes de los recursos."

#: transcria/web/config_form.py:172
msgid "Notifications email"
msgstr "Notificaciones por correo electrónico"

#: transcria/web/config_form.py:173
msgid "Email de fin de traitement (SMTP). Requiert une adresse dans le profil utilisateur."
msgstr "Correo electrónico de fin de trabajo (SMTP). Requiere una dirección en el perfil del usuario."

#: transcria/web/config_form.py:175
msgid "Activer les emails"
msgstr "Activar los correos electrónicos"

#: transcria/web/config_form.py:176
msgid "Envoie un email au propriétaire à la fin (succès/échec)."
msgstr "Envía un correo electrónico al propietario al finalizar (éxito/error)."

#: transcria/web/config_form.py:177
msgid "Serveur SMTP"
msgstr "Servidor SMTP"

#: transcria/web/config_form.py:178
msgid "Port SMTP"
msgstr "Puerto SMTP"

#: transcria/web/config_form.py:179
msgid "Ex. 587 (STARTTLS) ou 465 (SSL)."
msgstr "Ej. 587 (STARTTLS) o 465 (SSL)."

#: transcria/web/config_form.py:180
msgid "STARTTLS"
msgstr "STARTTLS"

#: transcria/web/config_form.py:181
msgid "SSL/SMTPS"
msgstr "SSL/SMTPS"

#: transcria/web/config_form.py:182
msgid "Adresse expéditeur"
msgstr "Dirección del remitente"

#: transcria/web/config_form.py:183
msgid "URL de base du portail"
msgstr "URL base del portal"

#: transcria/web/config_form.py:184
msgid "Utilisée dans les liens des emails, ex. http://localhost:7870."
msgstr "Se utiliza en los enlaces de los correos electrónicos, ej. http://localhost:7870."

#: transcria/web/config_form.py:188 transcria/web/templates/base.html:59
#: transcria/web/templates/voices.html:2 transcria/web/templates/voices.html:6
msgid "Voix enregistrées"
msgstr "Voces registradas"

#: transcria/web/config_form.py:189
msgid "Référentiel de voix connues (consentement requis)."
msgstr "Repositorio de voces conocidas (se requiere consentimiento)."

#: transcria/web/config_form.py:191
msgid "Activer les voix enregistrées"
msgstr "Activar las voces registradas"

#: transcria/web/config_form.py:192
msgid "Répertoire de stockage"
msgstr "Directorio de almacenamiento"

#: transcria/web/config_form.py:193
msgid "Stockage local protégé des voix et consentements."
msgstr "Almacenamiento local protegido de las voces y los consentimientos."

#: transcria/web/config_form.py:197
msgid "Identité d'entreprise (SSO)"
msgstr "Identidad corporativa (SSO)"

#: transcria/web/config_form.py:198
msgid "Connexion via un fournisseur OIDC (Keycloak, Entra ID, Authentik…). Redémarrage du service requis après changement. Compte local de secours : /login?local=1 (cf. docs/GESTION_IDENTITE.md)."
msgstr "Inicio de sesión mediante un proveedor OIDC (Keycloak, Entra ID, Authentik…). Requiere reinicio del servicio tras cualquier cambio. Cuenta local de emergencia: /login?local=1 (véase docs/GESTION_IDENTITE.md)."

#: transcria/web/config_form.py:202
msgid "Backend d'identité"
msgstr "Backend de identidad"

#: transcria/web/config_form.py:204
msgid "local (défaut) : comptes de ce portail. oidc : SSO d'entreprise. proxy : identité fournie par un proxy d'authentification frontal (Authelia, oauth2-proxy…). ldap : annuaire LDAP / Active Directory en direct. Renseignez les champs correspondants avant d'activer."
msgstr "local (predeterminado): cuentas de este portal. oidc: SSO corporativo. proxy: identidad proporcionada por un proxy de autenticación frontal (Authelia, oauth2-proxy…). ldap: acceso directo al directorio LDAP / Active Directory. Complete los campos correspondientes antes de activar."

#: transcria/web/config_form.py:208
msgid "Émetteur (issuer)"
msgstr "Emisor (issuer)"

#: transcria/web/config_form.py:209
msgid "URL de l'émetteur OIDC, ex. https://sso.exemple.fr/realms/entreprise (la découverte /.well-known est automatique)."
msgstr "URL del emisor OIDC, ej. https://sso.ejemplo.es/realms/empresa (el descubrimiento /.well-known es automático)."

#: transcria/web/config_form.py:211
msgid "Identifiant client"
msgstr "Identificador de cliente"

#: transcria/web/config_form.py:212
msgid "Secret client"
msgstr "Secreto de cliente"

#: transcria/web/config_form.py:214
msgid "Laissez vide si le secret est fourni par variable d'environnement."
msgstr "Déjelo vacío si el secreto se proporciona mediante una variable de entorno."

#: transcria/web/config_form.py:215
msgid "Variable d'environnement du secret"
msgstr "Variable de entorno del secreto"

#: transcria/web/config_form.py:216
msgid "Nom d'une variable d'environnement contenant le secret — prioritaire sur le champ précédent, évite le secret en clair dans config.yaml."
msgstr "Nombre de una variable de entorno que contiene el secreto — tiene prioridad sobre el campo anterior y evita el secreto en texto claro en config.yaml."

#: transcria/web/config_form.py:218
msgid "Libellé du bouton SSO"
msgstr "Etiqueta del botón SSO"

#: transcria/web/config_form.py:219
msgid "Texte du bouton sur la page de connexion, ex. « Connexion Entreprise ». Vide = libellé par défaut."
msgstr "Texto del botón en la página de inicio de sesión, ej. «Acceso corporativo». Vacío = etiqueta predeterminada."

#: transcria/web/config_form.py:221
msgid "Adresses de confiance du proxy"
msgstr "Direcciones de confianza del proxy"

#: transcria/web/config_form.py:222
msgid "Backend proxy uniquement : adresses IP ou réseaux CIDR du proxy frontal, ex. 127.0.0.1, 10.0.0.0/24. Les en-têtes d'identité ne sont crus QUE depuis ces adresses (adresse socket réelle, jamais X-Forwarded-For)."
msgstr "Solo backend proxy: direcciones IP o redes CIDR del proxy frontal, ej. 127.0.0.1, 10.0.0.0/24. Las cabeceras de identidad SOLO se consideran fiables desde estas direcciones (dirección de socket real, nunca X-Forwarded-For)."

#: transcria/web/config_form.py:226
msgid "En-tête utilisateur du proxy"
msgstr "Cabecera de usuario del proxy"

#: transcria/web/config_form.py:227
msgid "Nom de l'en-tête portant l'identifiant (convention : Remote-User)."
msgstr "Nombre de la cabecera que contiene el identificador (convención: Remote-User)."

#: transcria/web/config_form.py:228
msgid "En-tête groupes du proxy"
msgstr "Cabecera de grupos del proxy"

#: transcria/web/config_form.py:229
msgid "Nom de l'en-tête portant les groupes, séparés par des virgules (convention : Remote-Groups)."
msgstr "Nombre de la cabecera que contiene los grupos, separados por comas (convención: Remote-Groups)."

#: transcria/web/config_form.py:231
msgid "Connexion automatique via le proxy"
msgstr "Inicio de sesión automático mediante el proxy"

#: transcria/web/config_form.py:232
msgid "Activée : /login connecte directement depuis les en-têtes. Désactivée : la page affiche un bouton de connexion."
msgstr "Activada: /login inicia sesión directamente a partir de las cabeceras. Desactivada: la página muestra un botón de inicio de sesión."

#: transcria/web/config_form.py:234
msgid "Contrôleurs LDAP/AD"
