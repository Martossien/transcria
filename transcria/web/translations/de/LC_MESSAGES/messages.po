msgid "URL de l'émetteur OIDC, ex. https://sso.exemple.fr/realms/entreprise (la découverte /.well-known est automatique)."
msgstr "URL des OIDC-Ausstellers, z. B. https://sso.exemple.fr/realms/entreprise (die /.well-known-Erkennung erfolgt automatisch)."

#: transcria/web/config_form.py:211
msgid "Identifiant client"
msgstr "Client-ID"

#: transcria/web/config_form.py:212
msgid "Secret client"
msgstr "Client-Secret"

#: transcria/web/config_form.py:214
msgid "Laissez vide si le secret est fourni par variable d'environnement."
msgstr "Leer lassen, wenn das Secret über eine Umgebungsvariable bereitgestellt wird."

#: transcria/web/config_form.py:215
msgid "Variable d'environnement du secret"
msgstr "Umgebungsvariable für das Secret"

#: transcria/web/config_form.py:216
msgid "Nom d'une variable d'environnement contenant le secret — prioritaire sur le champ précédent, évite le secret en clair dans config.yaml."
msgstr "Name einer Umgebungsvariable mit dem Secret — hat Vorrang vor dem vorherigen Feld und vermeidet das Secret im Klartext in config.yaml."

#: transcria/web/config_form.py:218
msgid "Libellé du bouton SSO"
msgstr "Beschriftung der SSO-Schaltfläche"

#: transcria/web/config_form.py:219
msgid "Texte du bouton sur la page de connexion, ex. « Connexion Entreprise ». Vide = libellé par défaut."
msgstr "Text der Schaltfläche auf der Anmeldeseite, z. B. „Unternehmensanmeldung“. Leer = Standardbeschriftung."

#: transcria/web/config_form.py:221
msgid "Adresses de confiance du proxy"
msgstr "Vertrauenswürdige Proxy-Adressen"

#: transcria/web/config_form.py:222
msgid "Backend proxy uniquement : adresses IP ou réseaux CIDR du proxy frontal, ex. 127.0.0.1, 10.0.0.0/24. Les en-têtes d'identité ne sont crus QUE depuis ces adresses (adresse socket réelle, jamais X-Forwarded-For)."
msgstr "Nur Backend proxy: IP-Adressen oder CIDR-Netzwerke des vorgeschalteten Proxys, z. B. 127.0.0.1, 10.0.0.0/24. Identitäts-Header werden NUR von diesen Adressen akzeptiert (tatsächliche Socket-Adresse, niemals X-Forwarded-For)."

#: transcria/web/config_form.py:226
msgid "En-tête utilisateur du proxy"
msgstr "Proxy-Benutzer-Header"

#: transcria/web/config_form.py:227
msgid "Nom de l'en-tête portant l'identifiant (convention : Remote-User)."
msgstr "Name des Headers mit der Benutzerkennung (Konvention: Remote-User)."

#: transcria/web/config_form.py:228
msgid "En-tête groupes du proxy"
msgstr "Proxy-Gruppen-Header"

#: transcria/web/config_form.py:229
msgid "Nom de l'en-tête portant les groupes, séparés par des virgules (convention : Remote-Groups)."
msgstr "Name des Headers mit den durch Kommas getrennten Gruppen (Konvention: Remote-Groups)."

#: transcria/web/config_form.py:231
msgid "Connexion automatique via le proxy"
msgstr "Automatische Anmeldung über den Proxy"

#: transcria/web/config_form.py:232
msgid "Activée : /login connecte directement depuis les en-têtes. Désactivée : la page affiche un bouton de connexion."
msgstr "Aktiviert: /login meldet direkt anhand der Header an. Deaktiviert: Die Seite zeigt eine Anmeldeschaltfläche."

#: transcria/web/config_form.py:234
msgid "Contrôleurs LDAP/AD"
msgstr "LDAP/AD-Controller"

#: transcria/web/config_form.py:235
msgid "Backend ldap : un ou plusieurs contrôleurs, ex. ldaps://dc1.corp, ldaps://dc2.corp (essayés dans l'ordre pour la haute disponibilité). LDAPS (ldaps://) fortement recommandé."
msgstr "Backend ldap: ein oder mehrere Controller, z. B. ldaps://dc1.corp, ldaps://dc2.corp (werden der Reihe nach für Hochverfügbarkeit versucht). LDAPS (ldaps://) dringend empfohlen."

#: transcria/web/config_form.py:238
msgid "LDAPS (TLS)"
msgstr "LDAPS (TLS)"

#: transcria/web/config_form.py:239
msgid "Chiffre la liaison à l'annuaire. À désactiver seulement avec auth.ldap.allow_plaintext en connaissance de cause (mot de passe en clair)."
msgstr "Verschlüsselt die Verbindung zum Verzeichnis. Nur bewusst mit auth.ldap.allow_plaintext deaktivieren (Passwort im Klartext)."

