msgstr "Modus service: Lesekonto des Verzeichnisses, z. B. CN=svc-transcria,OU=Services,DC=corp,DC=example."

#: transcria/web/config_form.py:248
msgid "Mot de passe du compte de service"
msgstr "Passwort des Dienstkontos"

#: transcria/web/config_form.py:250
msgid "Laissez vide si fourni par variable d'environnement."
msgstr "Leer lassen, wenn über eine Umgebungsvariable bereitgestellt."

