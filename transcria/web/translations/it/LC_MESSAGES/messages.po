#: transcria/web/config_form.py:30
msgid "Réunions en ligne"
msgstr "Riunioni online"

#: transcria/web/config_form.py:31
msgid "Planification de bots de réunion par les utilisateurs (Zoom/Jitsi/Visio) — exige la façade temps réel active et un exécutant (meeting-runner) démarré."
msgstr "Pianificazione di bot di riunione da parte degli utenti (Zoom/Jitsi/Visio) — richiede la facciata in tempo reale attiva e un esecutore (meeting-runner) avviato."

#: transcria/web/config_form.py:34
msgid "Activer les réunions planifiées"
msgstr "Attiva le riunioni pianificate"

#: transcria/web/config_form.py:36
msgid "Fait apparaître « Depuis une réunion » à la création d'un job (si un exécutant est vivant) et ouvre l'API de planification."
msgstr "Fa comparire «Da una riunione» alla creazione di un lavoro (se un esecutore è attivo) e apre l'API di pianificazione."

#: transcria/web/config_form.py:38
msgid "Comptes de service runner"
msgstr "Account di servizio dell'esecutore"

#: transcria/web/config_form.py:40
msgid "Noms d'utilisateurs autorisés à opérer un meeting-runner — attribution nominative, jamais par rôle (revue sécurité)."
msgstr "Nomi utente autorizzati a gestire un meeting-runner — assegnazione nominativa, mai per ruolo (revisione di sicurezza)."

#: transcria/web/config_form.py:45
msgid "Modèles & backends"
msgstr "Modelli e backend"

#: transcria/web/config_form.py:46
msgid "Choix des moteurs de transcription et de diarisation."
msgstr "Scelta dei motori di trascrizione e diarizzazione."

#: transcria/web/config_form.py:48
msgid "Backend STT"
msgstr "Backend STT"

#: transcria/web/config_form.py:50
msgid "Moteur de transcription par défaut (cohere recommandé)."
msgstr "Motore di trascrizione predefinito (cohere consigliato)."

#: transcria/web/config_form.py:51
msgid "Backend STT du résumé"
msgstr "Backend STT della sintesi"

#: transcria/web/config_form.py:55
msgid "Moteur dédié à la transcription rapide de la phase résumé — vide = même moteur que le pipeline. kroko = CPU pur (zéro VRAM) ; qwen3asr/nemotron/voxtralrt exigent le runtime servi audio.cpp/parakeet.cpp (cf. docs/EXTERNAL_STT_RUNTIMES.md)."
msgstr "Motore dedicato alla trascrizione rapida della fase di sintesi — vuoto = stesso motore della pipeline. kroko = solo CPU (zero VRAM); qwen3asr/nemotron/voxtralrt richiedono il runtime servito audio.cpp/parakeet.cpp (cfr. docs/EXTERNAL_STT_RUNTIMES.md)."

#: transcria/web/config_form.py:58
msgid "Backend STT live (temps réel)"
msgstr "Backend STT live (tempo reale)"

#: transcria/web/config_form.py:61
msgid "Chaîne temps réel (faible latence) — vide = pas de live. Exige un moteur CONÇU streaming (nemotron-streaming, voxtralrt) ; jamais un moteur batch (cf. docs/TEMPS_REEL_REUNIONS.md)."
msgstr "Catena in tempo reale (bassa latenza) — vuoto = nessun live. Richiede un modello PROGETTATO per lo streaming (nemotron-streaming, voxtralrt); mai un modello batch (cfr. docs/TEMPS_REEL_REUNIONS.md)."

#: transcria/web/config_form.py:64
msgid "Backend diarisation"
msgstr "Backend diarizzazione"

#: transcria/web/config_form.py:66
msgid "Détection des locuteurs (pyannote recommandé)."
msgstr "Rilevamento dei parlanti (pyannote consigliato)."

#: transcria/web/config_form.py:70
msgid "Temps réel & connecteurs"
msgstr "Tempo reale e connettori"

#: transcria/web/config_form.py:71
msgid "Façade STT et ingestion des réunions (opt-in, désactivé par défaut)."
msgstr "Facciata STT e acquisizione delle riunioni (opt-in, disabilitata per impostazione predefinita)."

#: transcria/web/config_form.py:73
msgid "Façade STT temps réel"
msgstr "Facciata STT in tempo reale"

#: transcria/web/config_form.py:74
msgid "Expose POST /v1/audio/transcriptions (transcription OpenAI-audio) et POST /v1/audio/ingest (dépôt d'un enregistrement de réunion → job). Désactivé = endpoints absents. Authentifié par jeton d'API personnel (cf. docs/TEMPS_REEL_REUNIONS.md)."
msgstr "Espone POST /v1/audio/transcriptions (trascrizione OpenAI-audio) e POST /v1/audio/ingest (caricamento di una registrazione di riunione → lavoro). Disabilitato = endpoint assenti. Autenticato tramite token API personale (cfr. docs/TEMPS_REEL_REUNIONS.md)."

#: transcria/web/config_form.py:81
msgid "LLM d'arbitrage"
msgstr "LLM di arbitraggio"

#: transcria/web/config_form.py:82
msgid "Résumé et correction par la LLM locale OpenAI-compatible."
msgstr "Sintesi e correzione tramite la LLM locale compatibile OpenAI."

#: transcria/web/config_form.py:84
msgid "Activer la correction LLM"
msgstr "Attiva la correzione LLM"

#: transcria/web/config_form.py:85
msgid "Désactiver pour produire un SRT brut sans correction."
msgstr "Disattivare per produrre un SRT grezzo senza correzione."

#: transcria/web/config_form.py:86
msgid "Modèle de résumé"
msgstr "Modello di sintesi"

#: transcria/web/config_form.py:87
msgid "Identifiant opencode, ex. local/arbitrage."
msgstr "Identificatore"

#: transcria/web/config_form.py:88
msgid "Modèle de correction"
msgstr "Modello di correzione"

#: transcria/web/config_form.py:89
msgid "Identifiant opencode du modèle de correction du SRT."
msgstr "Identificatore"

#: transcria/web/config_form.py:90
msgid "Port du serveur LLM"
msgstr "Porta del server LLM"

#: transcria/web/config_form.py:91
msgid "Port du backend OpenAI-compatible (llama-server par défaut : 8080)."
msgstr "Porta del backend compatibile OpenAI (llama-server predefinito: 8080)."

#: transcria/web/config_form.py:92
msgid "Alias modèle rapporté par le serveur"
msgstr "Alias del modello riportato dal server"

#: transcria/web/config_form.py:93
msgid "Doit correspondre à l'alias servi (cf. scripts/check_arbitrage_llm.sh)."
msgstr "Deve corrispondere all'alias servito (cfr. scripts/check_arbitrage_llm.sh)."

#: transcria/web/config_form.py:97
msgid "File & exécution"
msgstr "Coda ed esecuzione"

#: transcria/web/config_form.py:98
msgid "File GPU persistante et parallélisme des jobs."
msgstr "Coda GPU persistente e parallelismo dei lavori."

#: transcria/web/config_form.py:100
msgid "File persistante activée"
msgstr "Coda persistente abilitata"

#: transcria/web/config_form.py:101
msgid "Mise en file des traitements (recommandé)."
msgstr "Messa in coda dei lavori (consigliato)."

#: transcria/web/config_form.py:102 transcria/web/templates/schedule.html:160
msgid "Jobs simultanés max"
msgstr "Lavori simultanei massimi"

#: transcria/web/config_form.py:103
msgid "Concurrence par défaut (1 = comportement historique)."
msgstr "Concorrenza predefinita (1 = comportamento storico)."

#: transcria/web/config_form.py:104
#: transcria/web/templates/dashboard_status.html:84
msgid "Stockage des fichiers de jobs"
msgstr "Archiviazione dei file dei lavori"

#: transcria/web/config_form.py:106
msgid "fs (défaut) : disque local — suffisant en tout-en-un ou avec un jobs_dir partagé (NFS). pg : fichiers répliqués via PostgreSQL — REQUIS quand la frontale (role=web) et le worker (role=scheduler) sont sur deux machines sans filesystem commun (cf. docs/STOCKAGE_PARTAGE_JOBS.md)."
msgstr "fs (predefinito): disco locale — sufficiente in modalità tutto-in-uno o con un jobs_dir condiviso (NFS). pg: file replicati tramite PostgreSQL — RICHIESTO quando il frontend (role=web) e il worker (role=scheduler) si trovano su due macchine senza filesystem condiviso (cfr. docs/STOCKAGE_PARTAGE_JOBS.md)."

#: transcria/web/config_form.py:113
msgid "Ressources GPU"
msgstr "Risorse GPU"

#: transcria/web/config_form.py:114
msgid "Récupération de la VRAM quand un job est bloqué faute de mémoire GPU."
msgstr "Recupero della VRAM quando un lavoro è bloccato per mancanza di memoria GPU."

#: transcria/web/config_form.py:116
msgid "Politique de préemption VRAM"
msgstr "Politica di prelazione VRAM"

#: transcria/web/config_form.py:118
msgid "own-only (recommandé) : n'arrête que NOS process gérés inactifs (LLM d'arbitrage), jamais un process tiers. aggressive : préempte aussi les serveurs d'inférence tiers, uniquement dans la fenêtre calendaire « force_gpu » — à réserver à un GPU dédié à TranscrIA."
msgstr "own-only (consigliato): arresta solo i NOSTRI processi gestiti inattivi (LLM di arbitraggio), mai un processo di terzi. aggressive: prelaziona anche i server di inferenza di terzi, solo all'interno della finestra calendariale «force_gpu» — da riservare a una GPU dedicata a TranscrIA."

#: transcria/web/config_form.py:122
msgid "VRAM libre minimale (Mo)"
msgstr "VRAM libera minima (MB)"

#: transcria/web/config_form.py:123
msgid "Marge libre exigée en plus du besoin d'une phase avant de l'allouer."
msgstr "Margine libero richiesto in aggiunta al fabbisogno di una fase prima di allocarla."

#: transcria/web/config_form.py:127
msgid "Sécurité & upload"
msgstr "Sicurezza e caricamento"

#: transcria/web/config_form.py:128
msgid "Limites d'upload et suppression des jobs."
msgstr "Limiti di caricamento ed eliminazione dei lavori."

#: transcria/web/config_form.py:130
msgid "Taille max d'upload (Mo)"
msgstr "Dimensione massima di caricamento (MB)"

#: transcria/web/config_form.py:131
msgid "Taille maximale d'un fichier déposé."
msgstr "Dimensione massima di un file caricato."

#: transcria/web/config_form.py:132
msgid "Extensions autorisées"
msgstr "Estensioni consentite"

#: transcria/web/config_form.py:133
msgid "Liste séparée par des virgules, ex. mp3, wav, mp4, m4a."
msgstr "Elenco separato da virgole, es. mp3, wav, mp4, m4a."

#: transcria/web/config_form.py:134
msgid "Autoriser la suppression de jobs"
msgstr "Consenti l'eliminazione dei lavori"

#: transcria/web/config_form.py:135
msgid "Permet aux admins de supprimer un job et ses fichiers."
msgstr "Consente agli amministratori di eliminare un lavoro e i relativi file."

#: transcria/web/config_form.py:139
msgid "Durcissement HTTP(S)"
msgstr "Rafforzamento HTTP(S)"

#: transcria/web/config_form.py:140
msgid "Sécurité du transport. Tout est opt-in (défaut = HTTP, dev/tout-en-un). Le proxy TLS et le cookie sécurisé exigent un redémarrage du service."
msgstr "Sicurezza del trasporto. Tutto è opt-in (predefinito = HTTP, dev/tutto-in-uno). Il proxy TLS e il cookie sicuro richiedono un riavvio del servizio."

#: transcria/web/config_form.py:143
msgid "Derrière un proxy TLS (HTTPS)"
msgstr "Dietro un proxy TLS (HTTPS)"

#: transcria/web/config_form.py:144
msgid "À activer si un reverse-proxy (nginx, Caddy…) termine le HTTPS devant TranscrIA : l'app reconnaît alors HTTPS (via X-Forwarded-Proto), marque le cookie de session Secure et peut émettre le HSTS. L'adresse cliente n'est JAMAIS lue depuis X-Forwarded-For (anti-usurpation). Redémarrage requis."
msgstr "Da attivare se un reverse-proxy (nginx, Caddy…) termina l'HTTPS davanti a TranscrIA: l'app riconosce quindi l'HTTPS (tramite X-Forwarded-Proto), contrassegna il cookie di sessione come Secure e può emettere l'HSTS. L'indirizzo del client non viene MAI letto da X-Forwarded-For (anti-spoofing). Riavvio richiesto."

#: transcria/web/config_form.py:148
msgid "Cookie de session « Secure »"
msgstr "Cookie di sessione «Secure»"

#: transcria/web/config_form.py:149
msgid "Marque le cookie de session Secure (envoyé seulement en HTTPS). Implicite si « Derrière un proxy TLS » est activé. Redémarrage requis."
msgstr "Contrassegna il cookie di sessione come Secure (inviato solo via HTTPS). Implicito se «Dietro un proxy TLS» è attivato. Riavvio richiesto."

#: transcria/web/config_form.py:151
msgid "HSTS (forcer HTTPS côté navigateur)"
msgstr "HSTS (forza HTTPS lato browser)"

#: transcria/web/config_form.py:152
msgid "Émet l'en-tête Strict-Transport-Security, uniquement sur une réponse servie en HTTPS réel (nécessite « Derrière un proxy TLS »). Anti-rétrogradation HTTP."
msgstr "Emette l'header Strict-Transport-Security, solo su una risposta effettivamente servita in HTTPS reale (richiede «Dietro un proxy TLS»). Anti-downgrade a HTTP."

#: transcria/web/config_form.py:154
msgid "Contrôle d'origine (anti-CSRF renforcé)"
msgstr "Controllo dell'origine (anti-CSRF rafforzato)"

#: transcria/web/config_form.py:156
msgid "Refuse un envoi de formulaire provenant d'un autre site (en-tête Origin croisé), en complément de SameSite. N'affecte ni l'API par jeton, ni les requêtes sans en-tête Origin."
msgstr "Rifiuta un invio di modulo proveniente da un altro sito (header Origin incrociato), in aggiunta a SameSite. Non riguarda né l'API a token né le richieste prive di header Origin."

#: transcria/web/config_form.py:159
msgid "Jetons CSRF (protection forte)"
msgstr "Token CSRF (protezione avanzata)"

#: transcria/web/config_form.py:160
msgid "Exige un jeton anti-CSRF à chaque requête mutante authentifiée par cookie (injecté automatiquement dans les formulaires et les appels de l'interface). Défense la plus forte ; l'API par jeton Bearer (scripts) reste exemptée."
msgstr "Richiede un token anti-CSRF per ogni richiesta modificante autenticata tramite cookie (iniettato automaticamente nei moduli e nelle chiamate dell'interfaccia). Difesa più forte; l'API a token Bearer (script) resta esente."

#: transcria/web/config_form.py:163
msgid "Content-Security-Policy (CSP)"
msgstr "Content-Security-Policy (CSP)"

#: transcria/web/config_form.py:165
msgid "Politique de sécurité du contenu. off : désactivée. report-only : le navigateur SIGNALE les violations sans rien bloquer (à déployer d'abord, pour observer). enforce : appliquée. Verrouille cadres, objets, base, formulaires et origines des ressources."
msgstr "Politica di sicurezza dei contenuti. off: disabilitata. report-only: il browser SEGNALA le violazioni senza bloccare nulla (da distribuire per prima cosa, per osservare). enforce: applicata. Blocca frame, oggetti, base, moduli e origini delle risorse."

#: transcria/web/config_form.py:172
msgid "Notifications email"
msgstr "Notifiche email"

#: transcria/web/config_form.py:173
msgid "Email de fin de traitement (SMTP). Requiert une adresse dans le profil utilisateur."
msgstr "Email di fine elaborazione (SMTP). Richiede un indirizzo nel profilo utente."

#: transcria/web/config_form.py:175
msgid "Activer les emails"
msgstr "Attiva le email"

#: transcria/web/config_form.py:176
msgid "Envoie un email au propriétaire à la fin (succès/échec)."
msgstr "Invia un'email al proprietario al termine (successo/fallimento)."

#: transcria/web/config_form.py:177
msgid "Serveur SMTP"
msgstr "Server SMTP"

#: transcria/web/config_form.py:178
msgid "Port SMTP"
msgstr "Porta SMTP"

#: transcria/web/config_form.py:179
msgid "Ex. 587 (STARTTLS) ou 465 (SSL)."
msgstr "Es. 587 (STARTTLS) o 465 (SSL)."

#: transcria/web/config_form.py:180
msgid "STARTTLS"
msgstr "STARTTLS"

#: transcria/web/config_form.py:181
msgid "SSL/SMTPS"
msgstr "SSL/SMTPS"

#: transcria/web/config_form.py:182
msgid "Adresse expéditeur"
msgstr "Indirizzo del mittente"

#: transcria/web/config_form.py:183
msgid "URL de base du portail"
msgstr "URL di base del portale"

#: transcria/web/config_form.py:184
msgid "Utilisée dans les liens des emails, ex. http://localhost:7870."
msgstr "Utilizzata nei link delle email, es. http://localhost:7870."

#: transcria/web/config_form.py:188 transcria/web/templates/base.html:59
#: transcria/web/templates/voices.html:2 transcria/web/templates/voices.html:6
msgid "Voix enregistrées"
msgstr "Voci registrate"

#: transcria/web/config_form.py:189
msgid "Référentiel de voix connues (consentement requis)."
msgstr "Archivio di voci note (consenso richiesto)."

#: transcria/web/config_form.py:191
msgid "Activer les voix enregistrées"
msgstr "Attiva le voci registrate"

#: transcria/web/config_form.py:192
msgid "Répertoire de stockage"
msgstr "Directory di archiviazione"

#: transcria/web/config_form.py:193
msgid "Stockage local protégé des voix et consentements."
msgstr "Archiviazione locale protetta di voci e consensi."

#: transcria/web/config_form.py:197
msgid "Identité d'entreprise (SSO)"
msgstr "Identità aziendale (SSO)"

#: transcria/web/config_form.py:198
msgid "Connexion via un fournisseur OIDC (Keycloak, Entra ID, Authentik…). Redémarrage du service requis après changement. Compte local de secours : /login?local=1 (cf. docs/GESTION_IDENTITE.md)."
msgstr "Accesso tramite un provider OIDC (Keycloak, Entra ID, Authentik…). Riavvio del servizio richiesto dopo la modifica. Account locale di emergenza: /login?local=1 (cfr. docs/GESTION_IDENTITE.md)."

#: transcria/web/config_form.py:202
msgid "Backend d'identité"
msgstr "Backend di identità"

#: transcria/web/config_form.py:204
msgid "local (défaut) : comptes de ce portail. oidc : SSO d'entreprise. proxy : identité fournie par un proxy d'authentification frontal (Authelia, oauth2-proxy…). ldap : annuaire LDAP / Active Directory en direct. Renseignez les champs correspondants avant d'activer."
msgstr "local (predefinito): account gestiti da questo portale. oidc: SSO aziendale. proxy: identità fornita da un proxy di autenticazione frontale (Authelia, oauth2-proxy…). ldap: directory LDAP / Active Directory diretta. Compili i campi corrispondenti prima di attivare."

#: transcria/web/config_form.py:208
msgid "Émetteur (issuer)"
msgstr "Autorità emittente (issuer)"

#: transcria/web/config_form.py:209
msgid "URL de l'émetteur OIDC, ex. https://sso.exemple.fr/realms/entreprise (la découverte /.well-known est automatique)."
msgstr "URL dell'emittente OIDC, es. https://sso.example.com/realms/company (la scoperta /.well-known è automatica)."

#: transcria/web/config_form.py:211
msgid "Identifiant client"
msgstr "Identificatore"

#: transcria/web/config_form.py:212
msgid "Secret client"
msgstr "Client secret"

#: transcria/web/config_form.py:214
msgid "Laissez vide si le secret est fourni par variable d'environnement."
msgstr "Lasciare vuoto se il secret proviene da una variabile d'ambiente."

#: transcria/web/config_form.py:215
msgid "Variable d'environnement du secret"
msgstr "Variabile d'ambiente del secret"

#: transcria/web/config_form.py:216
msgid "Nom d'une variable d'environnement contenant le secret — prioritaire sur le champ précédent, évite le secret en clair dans config.yaml."
msgstr "Nome di una variabile d'ambiente contenente il secret — ha priorità sul campo precedente ed evita di avere il secret in chiaro in config.yaml."

#: transcria/web/config_form.py:218
msgid "Libellé du bouton SSO"
msgstr "Etichetta"

#: transcria/web/config_form.py:219
msgid "Texte du bouton sur la page de connexion, ex. « Connexion Entreprise ». Vide = libellé par défaut."
msgstr "Testo del pulsante nella pagina di accesso, es. «Accesso aziendale». Vuoto = etichetta predefinita."

#: transcria/web/config_form.py:221
msgid "Adresses de confiance du proxy"
msgstr "Indirizzi affidabili del proxy"

#: transcria/web/config_form.py:222
msgid "Backend proxy uniquement : adresses IP ou réseaux CIDR du proxy frontal, ex. 127.0.0.1, 10.0.0.0/24. Les en-têtes d'identité ne sont crus QUE depuis ces adresses (adresse socket réelle, jamais X-Forwarded-For)."
msgstr "Solo backend proxy: indirizzi IP o reti CIDR del proxy frontale, es. 127.0.0.1, 10.0.0.0/24. Gli header di identità sono considerati attendibili SOLO da questi indirizzi (indirizzo socket reale, mai X-Forwarded-For)."

#: transcria/web/config_form.py:226
msgid "En-tête utilisateur du proxy"
msgstr "Header utente del proxy"

#: transcria/web/config_form.py:227
msgid "Nom de l'en-tête portant l'identifiant (convention : Remote-User)."
msgstr "Nome dell'header che contiene il nome utente (convenzione: Remote-User)."

#: transcria/web/config_form.py:228
msgid "En-tête groupes du proxy"
