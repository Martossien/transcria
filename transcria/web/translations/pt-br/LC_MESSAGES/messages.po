#: transcria/web/config_form.py:30
msgid "Réunions en ligne"
msgstr "Reuniões online"

#: transcria/web/config_form.py:31
msgid "Planification de bots de réunion par les utilisateurs (Zoom/Jitsi/Visio) — exige la façade temps réel active et un exécutant (meeting-runner) démarré."
msgstr "Agendamento de bots de reunião pelos usuários (Zoom/Jitsi/Visio) — requer uma fachada em tempo real ativa e um executor de reuniões em execução."

#: transcria/web/config_form.py:34
msgid "Activer les réunions planifiées"
msgstr "Ativar as reuniões planejadas"

#: transcria/web/config_form.py:36
msgid "Fait apparaître « Depuis une réunion » à la création d'un job (si un exécutant est vivant) et ouvre l'API de planification."
msgstr "Exibe 'De uma reunião' ao criar uma tarefa (se um executor estiver ativo) e abre a API de agendamento."

#: transcria/web/config_form.py:38
msgid "Comptes de service runner"
msgstr "Contas do serviço de executor"

#: transcria/web/config_form.py:40
msgid "Noms d'utilisateurs autorisés à opérer un meeting-runner — attribution nominative, jamais par rôle (revue sécurité)."
msgstr "Nomes dos usuários autorizados para operar um executor de reuniões — atribuídos por nome, nunca por função (revisão de segurança)."

#: transcria/web/config_form.py:45
msgid "Modèles & backends"
msgstr "Modelos e backends"

#: transcria/web/config_form.py:46
msgid "Choix des moteurs de transcription et de diarisation."
msgstr "Escolha dos mecanismos de transcrição e de diário."

#: transcria/web/config_form.py:48
msgid "Backend STT"
msgstr "Backend STT"

#: transcria/web/config_form.py:50
msgid "Moteur de transcription par défaut (cohere recommandé)."
msgstr "Mecanismo de transcrição padrão (cohere é recomendado)."

#: transcria/web/config_form.py:51
msgid "Backend STT du résumé"
msgstr "Backend de STT do resumo"

#: transcria/web/config_form.py:55
msgid "Moteur dédié à la transcription rapide de la phase résumé — vide = même moteur que le pipeline. kroko = CPU pur (zéro VRAM) ; qwen3asr/nemotron/voxtralrt exigent le runtime servi audio.cpp/parakeet.cpp (cf. docs/EXTERNAL_STT_RUNTIMES.md)."
msgstr "Mecanismo dedicado para transcrição rápida de resumos — vazio = mesmo mecanismo do pipeline. kroko = CPU pura (zero VRAM); qwen3asr/nemotron/voxtralrt requerem o runtime audio.cpp/parakeet.cpp (consulte docs/EXTERNAL_STT_RUNTIMES.md)."

#: transcria/web/config_form.py:58
msgid "Backend STT live (temps réel)"
msgstr "Backend de STT ao vivo (em tempo real)"

#: transcria/web/config_form.py:61
msgid "Chaîne temps réel (faible latence) — vide = pas de live. Exige un moteur CONÇU streaming (nemotron-streaming, voxtralrt) ; jamais un moteur batch (cf. docs/TEMPS_REEL_REUNIONS.md)."
msgstr "Cadeia em tempo real (baixa latência) — vazio = sem modo ao vivo. Requer um mecanismo PROJETADO para streaming (nemotron-streaming, voxtralrt); nunca um mecanismo em lote (consulte docs/TEMPS_REEL_REUNIONS.md)."

#: transcria/web/config_form.py:64
msgid "Backend diarisation"
msgstr "Backend de diário"

#: transcria/web/config_form.py:66
msgid "Détection des locuteurs : auto (Nemotron 3 de 1 à 8 voix, pyannote au-delà ou pour un comptage exact — recommandé), pyannote (illimité, token HF), sortformer (≤ 4, non gated), nemotron_diar (≤ 8, non gated, runtime audio.cpp, GPU ou CPU)."
msgstr "Detecção de participantes: auto (Nemotron 3 de 1 a 8 vozes; pyannote como opção padrão ou para contagem exata — recomendado), pyannote (ilimitado, token HF), sortformer (≤ 4, sem restrição de acesso), nemotron_diar (≤ 8, sem restrição de acesso, runtime audio.cpp, GPU ou CPU)."

#: transcria/web/config_form.py:69
msgid "Proposer la diarisation « auto »"
msgstr "Sugerir a diarização 'auto'"

#: transcria/web/config_form.py:70
msgid "Tant que le backend reste pyannote/sortformer explicite, la page Modèles, l'accueil et le doctor proposent de passer en « auto ». Décocher pour ne plus le voir."
msgstr "Enquanto o backend for explicitamente pyannote ou sortformer, a página de Modelos, a tela inicial e o diagnóstico sugerirão a mudança para 'auto'. Desmarque para não ver mais essa sugestão."

#: transcria/web/config_form.py:75
msgid "Temps réel & connecteurs"
msgstr "Tempo real e conectores"

#: transcria/web/config_form.py:76
msgid "Façade STT et ingestion des réunions (opt-in, désactivé par défaut)."
msgstr "Fachada STT e ingestão de reuniões (opcional, desativada por padrão)."

#: transcria/web/config_form.py:78
msgid "Façade STT temps réel"
msgstr "Fachada STT em tempo real"

#: transcria/web/config_form.py:79
msgid "Expose POST /v1/audio/transcriptions (transcription OpenAI-audio) et POST /v1/audio/ingest (dépôt d'un enregistrement de réunion → job). Désactivé = endpoints absents. Authentifié par jeton d'API personnel (cf. docs/TEMPS_REEL_REUNIONS.md)."
msgstr "Expõe POST /v1/audio/transcriptions (transcrição de áudio OpenAI) e POST /v1/audio/ingest (envio de uma gravação de reunião → tarefa). Desativado = endpoints ausentes. Autenticado usando um token de API pessoal (consulte docs/TEMPS_REEL_REUNIONS.md)."

#: transcria/web/config_form.py:86
msgid "LLM d'arbitrage"
msgstr "LLM de arbitragem"

#: transcria/web/config_form.py:87
msgid "Résumé et correction par la LLM locale OpenAI-compatible."
msgstr "Resumo e correção usando o LLM local compatível com OpenAI."

#: transcria/web/config_form.py:89
msgid "Activer la correction LLM"
msgstr "Ativar correção LLM"

#: transcria/web/config_form.py:90
msgid "Désactiver pour produire un SRT brut sans correction."
msgstr "Desative para gerar um SRT bruto não corrigido."

#: transcria/web/config_form.py:91
msgid "Modèle de résumé"
msgstr "Modelo de resumo"

#: transcria/web/config_form.py:92
msgid "Identifiant opencode, ex. local/arbitrage."
msgstr "Identificador opencode, por exemplo local/arbitragem."

#: transcria/web/config_form.py:93
msgid "Modèle de correction"
msgstr "Modelo de correção"

#: transcria/web/config_form.py:94
msgid "Identifiant opencode du modèle de correction du SRT."
msgstr "Identificador opencode do modelo de correção SRT."

#: transcria/web/config_form.py:95
msgid "Port du serveur LLM"
msgstr "Porta do servidor LLM"

#: transcria/web/config_form.py:96
msgid "Port du backend OpenAI-compatible (llama-server par défaut : 8080)."
msgstr "Porta do backend compatível com OpenAI (llama-server por padrão: 8080)."

#: transcria/web/config_form.py:97
msgid "Alias modèle rapporté par le serveur"
msgstr "Alias do modelo indicado pelo servidor"

#: transcria/web/config_form.py:98
msgid "Doit correspondre à l'alias servi (cf. scripts/check_arbitrage_llm.sh)."
msgstr "Deve corresponder ao alias fornecido (consulte scripts/check_arbitrage_llm.sh)."

#: transcria/web/config_form.py:102
msgid "File & exécution"
msgstr "Fila e execução"

#: transcria/web/config_form.py:103
msgid "File GPU persistante et parallélisme des jobs."
msgstr "Fila persistente da GPU e paralelismo das tarefas."

#: transcria/web/config_form.py:105
msgid "File persistante activée"
msgstr "Fila persistente ativada"

#: transcria/web/config_form.py:106
msgid "Mise en file des traitements (recommandé)."
msgstr "Enfileiramento de tarefas (recomendado)."

#: transcria/web/config_form.py:107 transcria/web/templates/schedule.html:160
msgid "Jobs simultanés max"
msgstr "Número máximo de tarefas simultâneas."

#: transcria/web/config_form.py:108
msgid "Concurrence par défaut (1 = comportement historique)."
msgstr "Concorrência padrão (1 = comportamento histórico)."

#: transcria/web/config_form.py:109
#: transcria/web/templates/dashboard_status.html:84
msgid "Stockage des fichiers de jobs"
msgstr "Armazenamento dos arquivos de tarefas"

#: transcria/web/config_form.py:111
msgid "fs (défaut) : disque local — suffisant en tout-en-un ou avec un jobs_dir partagé (NFS). pg : fichiers répliqués via PostgreSQL — REQUIS quand la frontale (role=web) et le worker (role=scheduler) sont sur deux machines sans filesystem commun (cf. docs/STOCKAGE_PARTAGE_JOBS.md)."
msgstr "fs (padrão): disco local — suficiente no modo tudo-em-um ou com um diretório jobs_dir compartilhado (NFS). pg: arquivos replicados usando PostgreSQL — OBRIGATÓRIO quando o frontend (role=web) e o worker (role=scheduler) estão em duas máquinas sem um sistema de arquivos compartilhado (consulte docs/STOCKAGE_PARTAGE_JOBS.md)."

#: transcria/web/config_form.py:118
msgid "Ressources GPU"
msgstr "Recursos da GPU"

#: transcria/web/config_form.py:119
msgid "Récupération de la VRAM quand un job est bloqué faute de mémoire GPU."
msgstr "Recuperação de VRAM quando uma tarefa é bloqueada devido à memória insuficiente da GPU."

#: transcria/web/config_form.py:121
msgid "Politique de préemption VRAM"
msgstr "Política de preempção de VRAM"

#: transcria/web/config_form.py:123
msgid "own-only (recommandé) : n'arrête que NOS process gérés inactifs (LLM d'arbitrage), jamais un process tiers. aggressive : préempte aussi les serveurs d'inférence tiers, uniquement dans la fenêtre calendaire « force_gpu » — à réserver à un GPU dédié à TranscrIA."
msgstr "own-only (recomendado): interrompe apenas NOSSOS processos gerenciados ociosos (LLM de arbitragem), nunca processos de terceiros, agressive: também interrompe os servidores de inferência de terceiros, somente dentro do intervalo de tempo 'force_gpu' — reservado para uma GPU dedicada para o TranscrIA."

#: transcria/web/config_form.py:127
msgid "VRAM libre minimale (Mo)"
msgstr "VRAM livre mínima (MB)"

#: transcria/web/config_form.py:128
msgid "Marge libre exigée en plus du besoin d'une phase avant de l'allouer."
msgstr "Espaço livre necessário, além da necessidade de uma fase, antes de alocá-lo."

#: transcria/web/config_form.py:132
msgid "Sécurité & upload"
msgstr "Segurança e upload de arquivos"

#: transcria/web/config_form.py:133
msgid "Limites d'upload et suppression des jobs."
msgstr "Limites de upload e exclusão das tarefas."

#: transcria/web/config_form.py:135
msgid "Taille max d'upload (Mo)"
msgstr "Tamanho máximo de upload (MB)"

#: transcria/web/config_form.py:136
msgid "Taille maximale d'un fichier déposé."
msgstr "Tamanho máximo de um arquivo enviado."

#: transcria/web/config_form.py:137
msgid "Extensions autorisées"
msgstr "Extensões permitidas"

#: transcria/web/config_form.py:138
msgid "Liste séparée par des virgules, ex. mp3, wav, mp4, m4a."
msgstr "Lista separada por vírgulas, ej. mp3, wav, mp4, m4a."

#: transcria/web/config_form.py:139
msgid "Autoriser la suppression de jobs"
msgstr "Permitir a exclusão de tarefas"

#: transcria/web/config_form.py:140
msgid "Permet aux admins de supprimer un job et ses fichiers."
msgstr "Permite que os administradores excluam uma tarefa e seus arquivos."

#: transcria/web/config_form.py:144
msgid "Durcissement HTTP(S)"
msgstr "Reforço de segurança HTTP(S)"

#: transcria/web/config_form.py:145
msgid "Sécurité du transport. Tout est opt-in (défaut = HTTP, dev/tout-en-un). Le proxy TLS et le cookie sécurisé exigent un redémarrage du service."
msgstr "Segurança de transporte. Tudo é opcional (padrão = HTTP, desenvolvimento/tudo-em-um). O proxy TLS e o cookie seguro exigem a reinicialização do serviço."

#: transcria/web/config_form.py:148
msgid "Derrière un proxy TLS (HTTPS)"
msgstr "Atrás de um proxy TLS (HTTPS)"

#: transcria/web/config_form.py:149
msgid "À activer si un reverse-proxy (nginx, Caddy…) termine le HTTPS devant TranscrIA : l'app reconnaît alors HTTPS (via X-Forwarded-Proto), marque le cookie de session Secure et peut émettre le HSTS. L'adresse cliente n'est JAMAIS lue depuis X-Forwarded-For (anti-usurpation). Redémarrage requis."
msgstr "Habilite esta opção se um proxy reverso (nginx, Caddy, etc.) encerrar o HTTPS antes do TranscrIA: o aplicativo então reconhecerá o HTTPS (usando X-Forwarded-Proto), marcará o cookie de sessão como Secure e poderá emitir HSTS. O endereço do cliente NUNCA é lido de X-Forwarded-For (anti-spoofing). Requer reinicialização."

#: transcria/web/config_form.py:153
msgid "Cookie de session « Secure »"
msgstr "Cookie de sessão 'Secure'"

#: transcria/web/config_form.py:154
msgid "Marque le cookie de session Secure (envoyé seulement en HTTPS). Implicite si « Derrière un proxy TLS » est activé. Redémarrage requis."
msgstr "Marca o cookie de sessão como Seguro (enviado somente por HTTPS). Implícito se 'Atrás de um proxy TLS' estiver habilitado. Requer reinicialização."

#: transcria/web/config_form.py:156
msgid "HSTS (forcer HTTPS côté navigateur)"
msgstr "HSTS (forçar HTTPS no navegador)"

#: transcria/web/config_form.py:157
msgid "Émet l'en-tête Strict-Transport-Security, uniquement sur une réponse servie en HTTPS réel (nécessite « Derrière un proxy TLS »). Anti-rétrogradation HTTP."
msgstr "Emite o cabeçalho Strict-Transport-Security somente em respostas servidas por HTTPS verdadeiro (requer 'Atrás de um proxy TLS'). Impede o downgrade para HTTP."

#: transcria/web/config_form.py:159
msgid "Contrôle d'origine (anti-CSRF renforcé)"
msgstr "Controle de origem (anti-CSRF reforçado)"

#: transcria/web/config_form.py:161
msgid "Refuse un envoi de formulaire provenant d'un autre site (en-tête Origin croisé), en complément de SameSite. N'affecte ni l'API par jeton, ni les requêtes sans en-tête Origin."
msgstr "Rejeita o envio de formulários de outros sites (cabeçalho Origin cruzado), como complemento ao SameSite. Não afeta APIs tokenizadas ou solicitações sem um cabeçalho Origin."

#: transcria/web/config_form.py:164
msgid "Jetons CSRF (protection forte)"
msgstr "Tokens CSRF (proteção forte)"

#: transcria/web/config_form.py:165
msgid "Exige un jeton anti-CSRF à chaque requête mutante authentifiée par cookie (injecté automatiquement dans les formulaires et les appels de l'interface). Défense la plus forte ; l'API par jeton Bearer (scripts) reste exemptée."
msgstr "Exige um token anti-CSRF em cada solicitação que modifica dados e é autenticada por um cookie (injetado automaticamente em formulários e chamadas de interface). Esta é a defesa mais forte; API com token Bearer (scripts) fica isenta."

#: transcria/web/config_form.py:168
msgid "Content-Security-Policy (CSP)"
msgstr "Content-Security-Policy (CSP)"

#: transcria/web/config_form.py:170
msgid "Politique de sécurité du contenu. off : désactivée. report-only : le navigateur SIGNALE les violations sans rien bloquer (à déployer d'abord, pour observer). enforce : appliquée. Verrouille cadres, objets, base, formulaires et origines des ressources."
msgstr "Política de segurança do conteúdo. off: desativada. report-only: o navegador NOTIFICA as violações sem bloquear nada (recomenda-se aplicá-la primeiro para observar). enforce: aplicada. Restringe frames, objetos, base, formulários e fontes dos recursos."

#: transcria/web/config_form.py:177
msgid "Notifications email"
msgstr "Notificações por e-mail"

#: transcria/web/config_form.py:178
msgid "Email de fin de traitement (SMTP). Requiert une adresse dans le profil utilisateur."
msgstr "E-mail de fim de tarefa (SMTP). Requer um endereço no perfil do usuário."

#: transcria/web/config_form.py:180
msgid "Activer les emails"
msgstr "Habilitar os e-mails"

#: transcria/web/config_form.py:181
msgid "Envoie un email au propriétaire à la fin (succès/échec)."
msgstr "Envia um e-mail ao proprietário após a conclusão (sucesso/erro)."

#: transcria/web/config_form.py:182
msgid "Serveur SMTP"
msgstr "Servidor SMTP"

#: transcria/web/config_form.py:183
msgid "Port SMTP"
msgstr "Porta SMTP"

#: transcria/web/config_form.py:184
msgid "Ex. 587 (STARTTLS) ou 465 (SSL)."
msgstr "Ex. 587 (STARTTLS) ou 465 (SSL)."

#: transcria/web/config_form.py:185
msgid "STARTTLS"
msgstr "STARTTLS"

#: transcria/web/config_form.py:186
msgid "SSL/SMTPS"
msgstr "SSL/SMTPS"

#: transcria/web/config_form.py:187
msgid "Adresse expéditeur"
msgstr "Endereço do remetente"

#: transcria/web/config_form.py:188
msgid "URL de base du portail"
msgstr "URL base do portal"

#: transcria/web/config_form.py:189
msgid "Utilisée dans les liens des emails, ex. http://localhost:7870."
msgstr "Usado em links de e-mail, por exemplo, http://localhost:7870."

#: transcria/web/config_form.py:193 transcria/web/templates/base.html:59
#: transcria/web/templates/voices.html:2 transcria/web/templates/voices.html:6
msgid "Voix enregistrées"
msgstr "Vozes registradas"

#: transcria/web/config_form.py:194
msgid "Référentiel de voix connues (consentement requis)."
msgstr "Repositório de vozes conhecidas (consentimento necessário)."

#: transcria/web/config_form.py:196
msgid "Activer les voix enregistrées"
msgstr "Ativar as vozes registradas"

#: transcria/web/config_form.py:197
msgid "Répertoire de stockage"
msgstr "Pasta de armazenamento"

#: transcria/web/config_form.py:198
msgid "Stockage local protégé des voix et consentements."
msgstr "Armazenamento local protegido de vozes e consentimentos."

#: transcria/web/config_form.py:202
msgid "Identité d'entreprise (SSO)"
msgstr "Identidade corporativa (SSO)"

#: transcria/web/config_form.py:198
msgid "Connexion via un fournisseur OIDC (Keycloak, Entra ID, Authentik…). Redémarrage du service requis après changement. Compte local de secours : /login?local=1 (cf. docs/GESTION_IDENTITE.md)."
msgstr "Login via um provedor OIDC (Keycloak, Entra ID, Authentik, etc.). Requer reinicialização do serviço após qualquer alteração. Conta local de emergência: /login?local=1 (consulte docs/GESTION_IDENTITE.md)."

#: transcria/web/config_form.py:207
msgid "Backend d'identité"
msgstr "Backend de identidade"

#: transcria/web/config_form.py:209
msgid "local (défaut) : comptes de ce portail. oidc : SSO d'entreprise. proxy : identité fournie par un proxy d'authentification frontal (Authelia, oauth2-proxy…). ldap : annuaire LDAP / Active Directory en direct. Renseignez les champs correspondants avant d'activer."
msgstr "local (padrão): contas deste portal. oidc: SSO corporativo. proxy: identidade fornecida por um proxy de autenticação front-end (Authelia, oauth2-proxy, etc.). ldap: acesso direto ao LDAP/Active Directory. Preencha os campos correspondentes antes de ativar."

#: transcria/web/config_form.py:213
msgid "Émetteur (issuer)"
msgstr "Emissor (issuer)"

#: transcria/web/config_form.py:214
msgid "URL de l'émetteur OIDC, ex. https://sso.exemple.fr/realms/entreprise (la découverte /.well-known est automatique)."
